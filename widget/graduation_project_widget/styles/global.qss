/* ============================================================
   global.qss — 心电异常检测桌面客户端统一样式表
   配色方案：
     主色    #14324a（深蓝灰）  副标题 #52667a
     危险    #b42318 / #fdecec
     警告    #b54708 / #fff4e5
     正常    #17663a / #eef8f1
     背景    #f0f2f5    卡片 #ffffff
   ============================================================ */

/* ---------- 全局基础 ---------- */
QWidget {
    font-family: "Microsoft YaHei", "Segoe UI", "PingFang SC", sans-serif;
    font-size: 13px;
    color: #1d2939;
}

/* ---------- 页面背景 ---------- */
QWidget#centralArea {
    background-color: #f0f2f5;
}

/* ---------- 页面标题 / 副标题 ---------- */
QLabel#pageTitle {
    font-size: 26px;
    font-weight: 700;
    color: #14324a;
    padding: 0;
}

QLabel#pageSubtitle {
    font-size: 13px;
    color: #52667a;
    padding: 0;
}

/* ---------- QGroupBox 卡片风格 ---------- */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #e4e7ec;
    border-radius: 8px;
    margin-top: 14px;
    padding: 16px 12px 12px 12px;
    font-weight: 600;
    color: #344054;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 2px 10px;
    background-color: #ffffff;
    border: 1px solid #e4e7ec;
    border-radius: 4px;
    color: #344054;
}

/* ---------- QPushButton 主按钮 ---------- */
QPushButton {
    background-color: #14324a;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 7px 18px;
    font-weight: 600;
    min-height: 28px;
}

QPushButton:hover {
    background-color: #1d4566;
}

QPushButton:pressed {
    background-color: #0d2234;
}

QPushButton:disabled {
    background-color: #d0d5dd;
    color: #98a2b3;
}

/* 危险按钮 */
QPushButton#dangerButton {
    background-color: #b42318;
}

QPushButton#dangerButton:hover {
    background-color: #d32f2f;
}

QPushButton#dangerButton:pressed {
    background-color: #8c1a12;
}

/* 次要按钮 */
QPushButton#secondaryButton {
    background-color: #ffffff;
    color: #344054;
    border: 1px solid #d0d5dd;
}

QPushButton#secondaryButton:hover {
    background-color: #f9fafb;
    border-color: #98a2b3;
}

QPushButton#secondaryButton:pressed {
    background-color: #f2f4f7;
}

/* ---------- QTableWidget ---------- */
QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #f9fafb;
    border: 1px solid #e4e7ec;
    border-radius: 6px;
    gridline-color: #f2f4f7;
    selection-background-color: #e0edff;
    selection-color: #1d2939;
    outline: none;
}

QTableWidget::item {
    padding: 4px 8px;
}

QTableWidget::item:selected {
    background-color: #e0edff;
    color: #1d2939;
}

QHeaderView::section {
    background-color: #f9fafb;
    color: #475467;
    font-weight: 600;
    padding: 6px 8px;
    border: none;
    border-bottom: 2px solid #e4e7ec;
    border-right: 1px solid #f2f4f7;
}

QHeaderView::section:last {
    border-right: none;
}

/* ---------- QLineEdit / QSpinBox / QComboBox 统一输入框 ---------- */
QLineEdit, QSpinBox, QComboBox {
    background-color: #ffffff;
    border: 1px solid #d0d5dd;
    border-radius: 6px;
    padding: 5px 10px;
    min-height: 24px;
    color: #1d2939;
    selection-background-color: #b2d4ff;
}

QLineEdit:focus, QSpinBox:focus, QComboBox:focus {
    border-color: #14324a;
}

QLineEdit:disabled, QSpinBox:disabled, QComboBox:disabled {
    background-color: #f9fafb;
    color: #98a2b3;
}

QLineEdit:read-only {
    background-color: #f9fafb;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #667085;
    margin-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #d0d5dd;
    border-radius: 4px;
    selection-background-color: #e0edff;
    selection-color: #1d2939;
    outline: none;
}

/* ---------- QPlainTextEdit 日志区域 ---------- */
QPlainTextEdit {
    background-color: #fafbfc;
    border: 1px solid #e4e7ec;
    border-radius: 6px;
    padding: 6px;
    font-family: "Cascadia Code", "Consolas", "Courier New", monospace;
    font-size: 12px;
    color: #344054;
    selection-background-color: #b2d4ff;
}

/* ---------- QTextEdit (报警详情摘要) ---------- */
QTextEdit {
    background-color: #fafbfc;
    border: 1px solid #e4e7ec;
    border-radius: 6px;
    padding: 6px;
    color: #344054;
    selection-background-color: #b2d4ff;
}

/* ---------- QScrollBar 美化 ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #d0d5dd;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #98a2b3;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #d0d5dd;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #98a2b3;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
    width: 0;
}

/* ---------- QFormLayout 标签 ---------- */
QFormLayout QLabel {
    color: #475467;
    font-weight: 500;
}

/* ---------- 提示标签（登录页） ---------- */
QLabel#tipLabel {
    color: #7a5b1f;
    background: #fff7e6;
    padding: 10px;
    border-radius: 6px;
}

/* ---------- QDialogButtonBox ---------- */
QDialogButtonBox QPushButton {
    min-width: 80px;
}

/* ---------- QMessageBox ---------- */
QMessageBox {
    background-color: #ffffff;
}

/* ---------- 分页控件 ---------- */
QWidget#paginationWidget {
    background: transparent;
}

QWidget#paginationWidget QLabel {
    color: #475467;
    font-weight: 500;
}

/* ---------- 侧边栏 ---------- */
QWidget#sidebarWidget {
    background-color: #14324a;
    border-right: 1px solid #0d2234;
}

QLabel#sidebarTitle {
    color: #ffffff;
    font-size: 15px;
    font-weight: 700;
    padding: 8px 4px;
}

QPushButton#sidebarButton {
    background-color: transparent;
    color: #b0c4d8;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    text-align: left;
    font-weight: 500;
    font-size: 13px;
}

QPushButton#sidebarButton:hover {
    background-color: #1d4566;
    color: #ffffff;
}

QPushButton#sidebarButton:checked {
    background-color: #1d4566;
    color: #ffffff;
    font-weight: 700;
}

QPushButton#sidebarButton:disabled {
    background-color: transparent;
    color: #526a80;
}

/* ---------- 仪表盘卡片 ---------- */
QGroupBox#dashboardCard {
    border: 1px solid #e4e7ec;
    border-radius: 10px;
    background-color: #ffffff;
}

QLabel#cardValue {
    color: #14324a;
}
